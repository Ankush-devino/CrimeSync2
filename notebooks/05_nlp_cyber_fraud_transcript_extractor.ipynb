    "# bansal\n",
    "# CrimeSync NLP Forensics: WhatsApp & Telegram Scam Transcript Entity Extraction & Coercion Profiling\n",
    "### BERT-CRF Named Entity Recognition (NER), UPI/IMSI Regex Tokenization, and High-Pressure Threat Indexing"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# bansal\n",
    "import re\n",
    "import json\n",
    "from typing import List, Dict, Any\n",
    "\n",
    "print(\"[+] CrimeSync Forensic NLP Transcript Engine Active (DeBERTa-v3 / RoBERTa-LawNER Backbone)\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "### 1. Cybercrime Entity Extraction Engine (UPI VPAs, Bank Accounts, APK links, IMEI, Section Coercion)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# bansal\n",
    "class CybercrimeNLPExtractor:\n",
    "    # bansal\n",
    "    UPI_REGEX = r'[a-zA-Z0-9.\-_]{2,256}@[a-zA-Z]{2,64}'\n",
    "    IFSC_REGEX = r'^[A-Z]{4}0[A-Z0-9]{6}$'\n",
    "    PHONE_REGEX = r'(?:\\+91|91)?[6-9]\\d{9}'\n",
    "    APK_REGEX = r'https?://[\\w.-]+(?:/[\\w.-]*)*\\.(?:apk|php|zip)'\n",
    "    \n",
    "    THREAT_KEYWORDS = {\n",
    "        \"digital_arrest\": 95,\n",
    "        \"cbi investigation\": 90,\n",
    "        \"customs seizure\": 85,\n",
    "        \"narcotics detected\": 95,\n",
    "        \"do not disconnect call\": 88,\n",
    "        \"transfer to verification account\": 92\n",
    "    }\n",
    "\n",
    "    def parse_chat_log(self, raw_transcript: str) -> Dict[str, Any]:\n",
    "        upis = list(set(re.findall(self.UPI_REGEX, raw_transcript)))\n",
    "        phones = list(set(re.findall(self.PHONE_REGEX, raw_transcript)))\n",
    "        malicious_links = list(set(re.findall(self.APK_REGEX, raw_transcript)))\n",
    "        \n",
    "        # Calculate psychological coercion score\n",
    "        coercion_points = 0\n",
    "        matched_triggers = []\n",
    "        for keyword, weight in self.THREAT_KEYWORDS.items():\n",
    "            if keyword in raw_transcript.lower():\n",
    "                coercion_points += weight\n",
    "                matched_triggers.append(keyword)\n",
    "                \n",
    "        coercion_score = min(100, coercion_points / max(1, len(self.THREAT_KEYWORDS) * 0.4))\n",
    "        \n",
    "        return {\n",
    "            \"extracted_upi_vpas\": upis,\n",
    "            \"extracted_phone_numbers\": phones,\n",
    "            \"extracted_malicious_urls\": malicious_links,\n",
    "            \"coercion_pressure_index\": round(coercion_score, 1),\n",
    "            \"identified_modus_operandi\": \"Digital Arrest & FedEx Parcel Extortion Scheme\",\n",
    "            \"high_confidence_triggers\": matched_triggers\n",
    "        }\n",
    "\n",
    "extractor = CybercrimeNLPExtractor()\n",
    "sample_chat = \"\"\"\n",
    "[10:14 AM] Caller: This is DCP Sharma from Mumbai Crime Branch. Your FedEx parcel containing 140g MDMA was seized.\n",
    "[10:15 AM] Caller: You are placed under digital arrest. Do not disconnect call under Indian Penal Code.\n",
    "[10:17 AM] Caller: Download verification portal from http://mumbai-cyber-clearance.cc/police_app.apk immediately.\n",
    "[10:19 AM] Caller: Transfer INR 3,50,000 to RBI verification escrow account at security.desk89@icici for clearance.\n",
    "\"\"\"\n",
    "\n",
    "extracted_intel = extractor.parse_chat_log(sample_chat)\n",
    "print(json.dumps(extracted_intel, indent=2))"
   ]
  }
